{
  "@context": {
    "@version": 1.1,
    "ioparam": "https://eosc-data-commons.github.io/software-ioparameter/",
    "bioschemas": "https://bioschemas.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "title": "dcterms:title",
    "description": "dcterms:description",
    "license": { "@id": "dcterms:license", "@type": "@id" },
    "versionInfo": "owl:versionInfo",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "range": { "@id": "rdfs:range", "@type": "@id" },
    "subClassOf": { "@id": "rdfs:subClassOf", "@type": "@id" },
    "Ontology": "owl:Ontology",
    "Property": "rdf:Property",
    "ObjectProperty": "owl:ObjectProperty",
    "Class": "rdfs:Class",
    "OwlClass": "owl:Class"
  },
  "@graph": [
    {
      "@id": "https://eosc-data-commons.github.io/software-ioparameter/",
      "@type": "Ontology",
      "title": { "@value": "Software Input/Output Parameter Vocabulary", "@language": "en" },
      "description": { "@value": "A lightweight vocabulary for connecting software applications and services to Bioschemas FormalParameter descriptions.", "@language": "en" },
      "license": "https://www.apache.org/licenses/LICENSE-2.0",
      "versionInfo": "0.2.0"
    },
    {
      "@id": "ioparam:inputParameter",
      "@type": ["Property", "ObjectProperty"],
      "label": { "@value": "input parameter", "@language": "en" },
      "comment": { "@value": "A formal parameter representing a value consumed by software or a service.", "@language": "en" },
      "range": "bioschemas:FormalParameter"
    },
    {
      "@id": "ioparam:outputParameter",
      "@type": ["Property", "ObjectProperty"],
      "label": { "@value": "output parameter", "@language": "en" },
      "comment": { "@value": "A formal parameter representing a value produced by software or a service.", "@language": "en" },
      "range": "bioschemas:FormalParameter"
    },
    {
      "@id": "ioparam:ParameterValue",
      "@type": ["Class", "OwlClass"],
      "label": { "@value": "parameter value", "@language": "en" },
      "comment": { "@value": "A structural category of value consumed or produced through a formal parameter.", "@language": "en" }
    },
    {
      "@id": "ioparam:File",
      "@type": ["Class", "OwlClass"],
      "label": { "@value": "file", "@language": "en" },
      "comment": { "@value": "A parameter value representing one file. Use schema:encodingFormat to state its media type or format.", "@language": "en" },
      "subClassOf": "ioparam:ParameterValue"
    },
    {
      "@id": "ioparam:Directory",
      "@type": ["Class", "OwlClass"],
      "label": { "@value": "directory", "@language": "en" },
      "comment": { "@value": "A parameter value representing a directory or folder, potentially containing files and subdirectories.", "@language": "en" },
      "subClassOf": "ioparam:ParameterValue"
    },
    {
      "@id": "ioparam:Array",
      "@type": ["Class", "OwlClass"],
      "label": { "@value": "array", "@language": "en" },
      "comment": { "@value": "A parameter value representing an ordered collection of zero or more values.", "@language": "en" },
      "subClassOf": "ioparam:ParameterValue"
    }
  ]
}
