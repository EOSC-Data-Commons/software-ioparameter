{
  "@context": [
    "https://w3id.org/codemeta/3.0",
    "https://w3id.org/software-types",
    "https://eosc-data-commons.github.io/software-ioparameter/context.jsonld"
  ],
  "@type": "SoftwareSourceCode",
  "name": "CernBox",
  "description": "Tool to send files to a CERNBox user.",
  "version": "v0",
  "applicationCategory": "Data access",
  "isSourceCodeOf": [
    {
      "@type": "WebAPI",
      "name": "CernBox",
      "endpointUrl": {
        "@type": "EntryPoint",
        "url": "https://cernbox.cern.ch/",
        "contentType": "application/json"
      },
      "inputParameter": [
        {
          "@type": "Parameter",
          "name": "Shared With",
          "valueName": "shared_with",
          "valueType": "xsd:string",
          "valueRequired": true
        }
      ],
      "inputFile": [
        {
          "@type": "File",
          "name": "Jupyter Notebook",
          "identifier": "notebook",
          "fileExtension": ".ipynb",
          "mediaType": "application/x-ipynb+json",
          "required": true
        }
      ]
    }
  ]
}
