{
  "@context": [
    "https://w3id.org/codemeta/3.0",
    "https://w3id.org/software-types",
    "https://eosc-data-commons.github.io/software-ioparameter/context.jsonld"
  ],
  "@type": "SoftwareSourceCode",
  "name": "CERNBox",
  "description": "Tool to send data to a CERNBox user. Requires login with MyAccessId.",
  "version": "v0",
  "applicationCategory": "data access",
  "isSourceCodeOf": [
    {
      "@type": "WebAPI",
      "name": "CERNBox",
      "endpointUrl": {
        "@type": "EntryPoint",
        "url": "https://cernbox.cern.ch/",
        "contentType": "multipart/form-data"
      },
      "inputParameter": [
        {
          "@type": "FormalParameter",
          "name": "Shared with",
          "identifier": "shared_with",
          "description": "CERNBox user with whom the file will be shared.",
          "additionalType": "xsd:string",
          "valueRequired": true
        },
      ]
    }
  ]
}
