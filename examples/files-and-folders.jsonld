{
  "@context": [
    "https://w3id.org/codemeta/3.0",
    "https://w3id.org/software-types",
    "https://eosc-data-commons.github.io/software-ioparameter/context.jsonld"
  ],
  "@type": "SoftwareSourceCode",
  "name": "Example image converter",
  "isSourceCodeOf": [
    {
      "@type": "CommandLineApplication",
      "name": "Example image converter",
      "executableName": "convert-images",
      "inputFile": [
        {
          "@type": "File",
          "name": "Configuration file",
          "identifier": "config",
          "path": "./config.json",
          "fileExtension": ".json",
          "mediaType": "application/json",
          "required": true
        }
      ],
      "inputFolder": [
        {
          "@type": "Folder",
          "name": "Source images",
          "identifier": "source",
          "path": "./images",
          "filePattern": "*.tiff",
          "recursive": true,
          "required": true
        }
      ],
      "outputFile": [
        {
          "@type": "File",
          "name": "Conversion report",
          "identifier": "report",
          "path": "./output/report.json",
          "fileExtension": ".json",
          "mediaType": "application/json"
        }
      ],
      "outputFolder": [
        {
          "@type": "Folder",
          "name": "Converted images",
          "identifier": "destination",
          "path": "./output"
        }
      ]
    }
  ]
}
