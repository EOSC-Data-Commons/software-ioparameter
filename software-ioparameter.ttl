@prefix ioparam: <https://w3id.org/software-ioparameter#> .
@prefix bioschemas: <https://bioschemas.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/software-ioparameter>
    a owl:Ontology ;
    dcterms:title "Software Input/Output Parameter Vocabulary"@en ;
    dcterms:description "A lightweight vocabulary for connecting software applications and services to Bioschemas FormalParameter descriptions."@en ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    owl:versionInfo "0.2.0" .

ioparam:inputParameter
    a rdf:Property, owl:ObjectProperty ;
    rdfs:label "input parameter"@en ;
    rdfs:comment "A formal parameter representing a value consumed by software or a service."@en ;
    rdfs:range bioschemas:FormalParameter .

ioparam:outputParameter
    a rdf:Property, owl:ObjectProperty ;
    rdfs:label "output parameter"@en ;
    rdfs:comment "A formal parameter representing a value produced by software or a service."@en ;
    rdfs:range bioschemas:FormalParameter .

ioparam:ParameterValue
    a rdfs:Class, owl:Class ;
    rdfs:label "parameter value"@en ;
    rdfs:comment "A structural category of value consumed or produced through a formal parameter."@en .

ioparam:File
    a rdfs:Class, owl:Class ;
    rdfs:label "file"@en ;
    rdfs:comment "A parameter value representing one file. Use schema:encodingFormat to state its media type or format."@en ;
    rdfs:subClassOf ioparam:ParameterValue .

ioparam:Directory
    a rdfs:Class, owl:Class ;
    rdfs:label "directory"@en ;
    rdfs:comment "A parameter value representing a directory or folder, potentially containing files and subdirectories."@en ;
    rdfs:subClassOf ioparam:ParameterValue .

ioparam:Array
    a rdfs:Class, owl:Class ;
    rdfs:label "array"@en ;
    rdfs:comment "A parameter value representing an ordered collection of zero or more values."@en ;
    rdfs:subClassOf ioparam:ParameterValue .
