{
  "@context": {
    "@version": 1.1,
    "ioparam": "https://eosc-data-commons.github.io/software-ioparameter/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Parameter": "ioparam:Parameter",
    "File": "ioparam:File",
    "Folder": "ioparam:Folder",
    "inputParameter": {
      "@id": "ioparam:inputParameter",
      "@container": "@set"
    },
    "inputFile": {
      "@id": "ioparam:inputFile",
      "@container": "@set"
    },
    "inputFolder": {
      "@id": "ioparam:inputFolder",
      "@container": "@set"
    },
    "outputFile": {
      "@id": "ioparam:outputFile",
      "@container": "@set"
    },
    "outputFolder": {
      "@id": "ioparam:outputFolder",
      "@container": "@set"
    },
    "valueType": {
      "@id": "ioparam:valueType",
      "@type": "@id"
    },
    "mediaType": "ioparam:mediaType",
    "fileExtension": "ioparam:fileExtension",
    "path": "ioparam:path",
    "filePattern": "ioparam:filePattern",
    "recursive": "ioparam:recursive",
    "required": "ioparam:required"
  }
}
