{
  "@context": {
    "@version": 1.1,
    "ioparam": "https://eosc-data-commons.github.io/software-ioparameter/",
    "bioschemas": "https://bioschemas.org/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "FormalParameter": "bioschemas:FormalParameter",
    "ParameterValue": "ioparam:ParameterValue",
    "File": "ioparam:File",
    "Directory": "ioparam:Directory",
    "Array": "ioparam:Array",
    "inputParameter": {
      "@id": "ioparam:inputParameter",
      "@type": "@id",
      "@container": "@set"
    },
    "outputParameter": {
      "@id": "ioparam:outputParameter",
      "@type": "@id",
      "@container": "@set"
    },
    "additionalType": {
      "@id": "schema:additionalType",
      "@type": "@id",
      "@container": "@set"
    }
  }
}
